# ---------------------------------------------------------------- Telegram
# Bot token from @BotFather
BOT_TOKEN=
# api_id and api_hash from https://my.telegram.org (needed by the local Bot API server)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Any random string of A-Z, a-z, 0-9, _ and - (e.g. `openssl rand -hex 32`)
WEBHOOK_SECRET=
# Telegram user id allowed to use /stats
OWNER_ID=
# Comma-separated chat ids the bot works in; empty = all chats
ALLOWED_CHATS=
# Timeout of one Bot API request (uploads of large files take a while)
TELEGRAM_REQUEST_TIMEOUT_SECONDS=300
# Attempts per Bot API request when Telegram answers 429 (waits retry_after in between)
TELEGRAM_RETRY_ATTEMPTS=3

# ---------------------------------------------------------------- Network
# Service names inside the compose network
GATEWAY_HOST=gateway
BOT_API_HOST=bot-api
POSTGRES_HOST=postgres
REDIS_HOST=redis
# Ports the services listen on inside the network (standard ports are not used)
GATEWAY_PORT=18080
BOT_API_PORT=18081
POSTGRES_PORT=54329
REDIS_PORT=63790
# Metrics ports; the only ones published on the host, bound to 127.0.0.1
GATEWAY_METRICS_PORT=19090
WORKER_METRICS_PORT=19091
# Host port range for worker metrics: one port per worker replica
WORKER_METRICS_HOST_PORTS=19091-19110

# ---------------------------------------------------------------- Storage
POSTGRES_USER=fetchly
POSTGRES_PASSWORD=
POSTGRES_DB=fetchly
REDIS_PASSWORD=

# ---------------------------------------------------------------- Intake limits
# Downloads per minute for one user / one chat; links over the limit are ignored
USER_RATE_PER_MINUTE=5
CHAT_RATE_PER_MINUTE=20
# Links processed from one message
MAX_LINKS_PER_MESSAGE=3

# ---------------------------------------------------------------- Send limits
# Messages per minute into one chat (an album counts as its number of items)
SEND_RATE_PER_CHAT_PER_MINUTE=20
# Messages per second across all chats and workers
SEND_RATE_GLOBAL_PER_SECOND=25

# ---------------------------------------------------------------- Media limits
MAX_FILE_SIZE_MB=500
MAX_DURATION_SECONDS=900
# Preferred maximum video height
MAX_VIDEO_HEIGHT=1080
# Maximum photos/videos taken from one post
MAX_ALBUM_ITEMS=10

# ---------------------------------------------------------------- Worker
# Jobs processed in parallel by one worker container
WORKER_CONCURRENCY=4
# Attempts per job before it goes to the dead-letter stream
JOB_MAX_ATTEMPTS=3
# A job without a heartbeat for this long is taken over by another worker
JOB_CLAIM_IDLE_SECONDS=60
# How often a worker confirms it is still working on a job (keep well below the value above)
JOB_HEARTBEAT_SECONDS=15
# Lifetime of the per-message job counter used for reactions
JOB_STATE_TTL_SECONDS=86400
# How long a worker waits for a new job before checking for abandoned ones
QUEUE_BLOCK_SECONDS=5
# Hard limit for one yt-dlp / gallery-dl run; the process is killed afterwards
DOWNLOAD_TIMEOUT_SECONDS=300
# Lock that prevents parallel downloads of the same link: lifetime and how long others wait
URL_LOCK_TTL_SECONDS=900
URL_LOCK_WAIT_SECONDS=330
# Lifetime of file_id entries in Redis (Postgres keeps them forever)
CACHE_TTL_SECONDS=604800
# Pause after a platform blocks us: first pause and the cap; doubles on every repeat
PAUSE_BASE_SECONDS=60
PAUSE_MAX_SECONDS=3600
# Interval of housekeeping (download partitions, orphaned temp files)
MAINTENANCE_INTERVAL_SECONDS=21600
# Time docker gives a worker to finish its jobs on stop
WORKER_STOP_GRACE_SECONDS=330

# ---------------------------------------------------------------- Paths (inside containers)
# Volume shared by worker and bot-api; files are passed by path
SHARED_DIR=/var/lib/fetchly/shared
# Where ./cookies is mounted
COOKIES_DIR=/cookies

# ---------------------------------------------------------------- Proxies
# One per platform, e.g. socks5://user:pass@host:1080 or http://host:3128; empty = direct
PROXY_TIKTOK=
PROXY_INSTAGRAM=
PROXY_YOUTUBE=
PROXY_TWITTER=
PROXY_REDDIT=
PROXY_FACEBOOK=

# ---------------------------------------------------------------- Logging
LOG_LEVEL=INFO
